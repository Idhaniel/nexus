# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Blockchain
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYourDeployedContractAddress
POLYGON_AMOY_RPC_URL=https://polygon-amoy.drpc.org
DEPLOYER_PRIVATE_KEY=your-deployer-wallet-private-key
RECORDER_PRIVATE_KEY=your-recorder-wallet-private-key
POLYGONSCAN_API_KEY=your-polygonscan-api-key

# App
NEXT_PUBLIC_APP_NAME=NexusLens
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: seed script — UUID of an existing auth user (profiles row)
# SEED_USER_ID=
